# ============================================================
# API GATEWAY
# ============================================================
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# User Service URL (internal Docker network)
USER_SERVICE_URL=http://user-service:3001

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# ============================================================
# USER SERVICE
# ============================================================
USER_SERVICE_PORT=3001
USER_SERVICE_HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/userdb?schema=public

# ============================================================
# NOTIFICATION SERVICE
# ============================================================
NOTIFICATION_SERVICE_PORT=3002

# ============================================================
# NATS
# ============================================================
NATS_URL=nats://nats:4222
NATS_STREAM_NAME=USER_EVENTS
NATS_CONSUMER_NAME=notification-service-consumer
NATS_MAX_DELIVER=5
NATS_ACK_WAIT_SECONDS=30

# ============================================================
# POSTGRES
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=userdb

# ============================================================
# ENVIRONMENT
# ============================================================
NODE_ENV=development
LOG_LEVEL=info
